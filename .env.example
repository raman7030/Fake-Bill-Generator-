# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key with Places API (New) enabled.
VITE_GOOGLE_MAPS_API_KEY="" # Set locally; restrict this browser key by HTTP referrer and required APIs.

# GEMINI_API_KEY: Optional Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
